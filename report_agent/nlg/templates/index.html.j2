<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Report Agent — Index</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="css/report.css" />
  <style>
    /* Index page color overrides */
    :root {
      --bg: #0b0d12;
      --fg: #e7edf3;
      --muted: #aab7c7;
      --card: #121722;
      --accent: #7aa2ff;
      --accent-hover: #8bb0ff;
      --border: #1e2636;
    }
    header {
      background: linear-gradient(180deg, #101522, #0b0d12);
    }
    .wrap { max-width: 1200px; }
    h1 { font-size: 28px; }
    .meta { font-size: 14px; margin-top: 8px; }
  </style>
</head>
<body>
  <header>
    <div class="wrap">
      <h1>Report Agent</h1>
      <div class="meta">
        AI-powered data reports from ClickHouse + dbt
        {% if summary_path %}
        · <a href="{{ summary_path }}" style="color: var(--accent);">View Weekly Report</a>
        {% endif %}
      </div>
    </div>
  </header>

  <main class="wrap">
    {% if summary_path %}
    <div class="card" style="background: linear-gradient(135deg, #0f1a2e 0%, #1a2332 100%); border: 1px solid rgba(122, 162, 255, 0.2); margin-bottom: 24px;">
      <h2 style="margin: 0 0 12px; color: var(--fg); font-size: 24px; font-weight: 600;">Weekly Report</h2>
      <p style="margin: 0 0 16px; color: var(--muted); font-size: 15px;">
        Get a high-level overview of all key metrics and insights
      </p>
      <a href="{{ summary_path }}" class="summary-link" style="background: var(--accent); color: #fff; display: inline-block; padding: 12px 24px; border-radius: 8px; font-weight: 600; text-decoration: none; transition: background 0.2s;">
        View Summary Report →
      </a>
    </div>
    {% endif %}

    <div class="card">
      <div class="stats">
        <div class="stat-item">
          Total Reports: <span class="stat-value" id="total-count">{{ total_reports }}</span>
        </div>
        <div class="stat-item">
          Showing: <span class="stat-value" id="showing-count">{{ total_reports }}</span>
        </div>
      </div>

      <div class="search-bar">
        <input 
          type="text" 
          id="search-input" 
          class="search-input" 
          placeholder="Search reports by metric name..."
          autocomplete="off"
        />
      </div>
    </div>

    <div id="reports-container">
      {% if sorted_dates %}
        {% for date in sorted_dates %}
        <div class="date-group" data-date="{{ date }}">
          <div class="date-header">{{ date }}</div>
          <div class="report-grid">
            {% for report in reports_by_date[date] %}
            <a href="{{ report.filename }}" class="report-card" data-model="{{ report.model }}" data-display-name="{{ report.display_name }}" data-date="{{ date }}">
              <div class="report-card-title">{{ report.display_name }}</div>
              <div class="report-card-meta">
                Generated: {{ report.date.strftime('%Y-%m-%d %H:%M') }}
              </div>
            </a>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      {% else %}
        <div class="card">
          <div class="no-results">No reports found. Run <code>report-agent</code> to generate reports.</div>
        </div>
      {% endif %}
    </div>

    <div id="no-results" class="card no-results" style="display: none;">
      No reports match your search criteria.
    </div>
  </main>

  <script>
    (function() {
      const searchInput = document.getElementById('search-input');
      const reportCards = document.querySelectorAll('.report-card');
      const showingCount = document.getElementById('showing-count');
      const noResults = document.getElementById('no-results');
      
      let currentSearch = '';

      function updateDisplay() {
        let visibleCount = 0;
        let hasVisibleGroups = false;

        // Filter by search (search in both model name and display name)
        reportCards.forEach(card => {
          const model = card.getAttribute('data-model').toLowerCase();
          const displayName = (card.getAttribute('data-display-name') || '').toLowerCase();
          const searchLower = currentSearch.toLowerCase();
          const matchesSearch = currentSearch === '' || 
            model.includes(searchLower) || 
            displayName.includes(searchLower);
          
          const shouldShow = matchesSearch;
          card.classList.toggle('hidden', !shouldShow);
          
          if (shouldShow) {
            visibleCount++;
          }
        });

        // Hide/show date groups based on visible cards
        document.querySelectorAll('.date-group').forEach(group => {
          const hasVisible = Array.from(group.querySelectorAll('.report-card'))
            .some(card => !card.classList.contains('hidden'));
          group.style.display = hasVisible ? '' : 'none';
          if (hasVisible) hasVisibleGroups = true;
        });

        // Update counts
        showingCount.textContent = visibleCount;
        
        // Show/hide no results message
        noResults.style.display = (visibleCount === 0 && currentSearch) ? 'block' : 'none';
      }

      // Search input handler
      searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value.trim();
        updateDisplay();
      });

      // Initial display
      updateDisplay();
    })();
  </script>
</body>
</html>
